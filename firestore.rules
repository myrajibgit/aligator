service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isValidUser() { return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }

    // Users: can read any user (for search/leaderboard), can only write own profile
    match /users/{uid} {
      allow read: if isAuthenticated();
      // Students may edit their public profile and onboarding choices, but XP,
      // rankings, and all derived stats are server-owned.
      allow create: if isOwner(uid) && request.resource.data.keys().hasOnly([
        'displayName', 'username', 'bio', 'photoUrl', 'updatedAt'
      ]);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'bio', 'photoUrl', 'schoolId', 'classId',
          'streamId', 'area', 'subjectIds', 'onboardingComplete', 'updatedAt',
          'blockedUids'
        ])
        // A completed student cannot move themselves into another cohort to
        // manipulate class, school, or area leaderboards.
        && (resource.data.onboardingComplete != true ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'username', 'bio', 'photoUrl', 'updatedAt', 'blockedUids'
          ]))
        && (request.resource.data.onboardingComplete != true ||
          (request.resource.data.schoolId is string && request.resource.data.schoolId.size() > 0 &&
           request.resource.data.classId is string && request.resource.data.classId.size() > 0 &&
           request.resource.data.subjectIds is list && request.resource.data.subjectIds.size() > 0));
      allow delete: if false; // never allow client-side delete

      // Study photo anti-cheat fingerprint hashes
      match /studyHashes/{hashId} {
        allow read, write: if isOwner(uid);
      }

      // Solo-Leveling daily awakening streak & crate tracking
      match /streaks/{docId} {
        allow read, write: if isOwner(uid);
      }

      // In-app hunter notification bell — owner only
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        // Cloud Functions write new notifications; client marks them read.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create, delete: if false; // server-side only
      }

      // Daily dedup log so we don’t spam the same notification twice in one day
      match /notificationSentLog/{dayId} {
        allow read, write: if isOwner(uid);
      }

      // Hunter inventory vault & active equipment loadout
      match /inventory/{relicId} {
        allow read, write: if isOwner(uid);
      }
      match /equipment/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Schools: anyone authenticated can read, only authenticated can submit request
    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admin/functions write
    }

    // School requests: authenticated can create
    match /schoolRequests/{reqId} {
      allow create: if isAuthenticated()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 120
        && request.resource.data.country is string
        && request.resource.data.country.size() >= 2
        && request.resource.data.country.size() <= 80
        && request.resource.data.status == 'pending';
      allow read: if false;
    }

    // Classes: authenticated can read
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Subjects: authenticated can read
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Question bank: authenticated can read
    match /questionBank/{subjectId}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Syllabi metadata: authenticated can read, only admin can write
    match /syllabi/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Missions: only owner can read/write their own missions
    match /missions/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Chats: only members can read/write the chat doc and its messages
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 2
        && request.resource.data.memberUids.size() <= 6
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      match /messages/{msgId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
        // A chat participant may flag a message, but cannot alter its text,
        // sender, timestamp, or any other moderation data. Cloud Functions
        // bypass these rules when they need to replace abusive content.
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported']) &&
          request.resource.data.reported == true;
        allow delete: if false;
      }
    }

    // Parties: authenticated can read any party roster, members can update or delete if last member
    match /parties/{partyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
    }

    // Dungeon Gates (Co-op Boss Raids): authenticated students can participate
    match /dungeonGates/{gateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Leaderboards: read-only for authenticated users
    match /leaderboards/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Battles: participants can read
    match /battles/{battleId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.challengerUid || 
         request.auth.uid == resource.data.challengedUid);
      // Challenges, results, and rewards are created atomically by callable
      // backend functions. This prevents forged wins and XP changes.
      allow create, update, delete: if false;
    }

    // Moderation Reports: authenticated users can create, never read client-side
    match /moderationReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false;
    }
  }
}
